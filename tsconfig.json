{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "jsx": "react"
  },
  "include": ["src/renderer/**/*"],
  "exclude": ["node_modules"]
}
